# คัดลอกเป็น .env แล้ว chmod 600 (ห้าม commit ไฟล์ .env)
# ใช้บัญชีฐานข้อมูลที่ "อ่านอย่างเดียว" (SELECT) เท่านั้น
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hos
DB_USER=<readonly_user>
DB_PASS=<password>
PORT=5700

# ---- ค่าเสริม (ไม่ใส่ก็ได้) — ความหมายดู INSTALL.md หัวข้อ 4
# IPD_HOSPITAL_NAME=โรงพยาบาล...
# IPD_HOSPITAL_NAME_EN=... HOSPITAL
# IPD_CONTACT=งานสารสนเทศ โทร 1234
# IPD_TOTAL_BEDS=40
# IPD_MAX_DAYS=366
# IPD_CACHE_TTL=120
# IPD_DB_TIMEOUT=60
# IPD_EXPORT=1
# IPD_EXPORT_WAIT=0
# IPD_EXPORT_CACHE_TTL=300
# IP สาธารณะจริงของ รพ. (เข้าผ่าน Cloudflare) — นับเป็นคนใน รพ. · เครื่อง 192.168.x.x นับเป็นคนในอยู่แล้ว · ห้ามใส่ IP บ้าน/มือถือ
# IPD_LAN_NETS=203.0.113.10
# IPD_TRUSTED_PROXIES=127.0.0.1,::1
# คนนอก รพ.: ช่วงวันที่ปัดเป็นเดือนเต็ม · สถานะจำหน่ายที่น้อยกว่าค่านี้รวมเป็น "สถานะอื่น" (กันย้อนหาผู้เสียชีวิตราย ward รายวัน)
# · กลุ่มโรคหลัก/Readmission ตามกลุ่มโรคที่น้อยกว่าค่านี้แสดงเป็น "<5" · 0 = ปิด
# IPD_PUBLIC_MIN_CELL=5
